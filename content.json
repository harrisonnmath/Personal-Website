  "papers": [
    {
      "title": "Strong Ill-Posedness of the Surface Quasi-Geostrophic Equations in Wᵏ,¹(ℝ²)",
      "authors": "Elaine Cozzi, Nicholas Harrison, and Zachary Radke",
      "status": "Manuscript · November 2026",
      "description": "Small changes to the starting state of inviscid SQG can quickly become large when measured through spatial derivatives. We also construct starting states whose derivative norm has unbounded essential supremum on every initial time interval, which does not mean it is infinite at every positive time.",
      "url": "",
      "detail": "sqg"
    },
    {
      "detail": "euler-logarithmic",
      "title": "Ill-Posedness of the 2D Euler Equations in a Logarithmically Refined Critical Sobolev Space",
      "authors": "Elaine Cozzi, Nicholas Harrison, and Zachary Radke",
      "status": "Journal of Dynamics and Differential Equations · 2026",
      "description": "Can a little extra smoothness prevent instability in an ideal two-dimensional fluid? We show that certain logarithmic improvements to the critical smoothness requirement still allow arbitrarily small starting states to develop very large regularity norms.",
      "url": "assets/papers/euler-logarithmic-illposedness-author.pdf",
      "source": "https://arxiv.org/abs/2510.20773",
      "publisher": "https://doi.org/10.1007/s10884-026-10532-z",
      "pdfLabel": "Author PDF"
    },
    {
      "detail": "euler-smoothness",
      "title": "Well-Posedness for the Euler Equations in Function Spaces of Generalized Smoothness",
      "authors": "Nicholas Harrison and Zachary Radke",
      "status": "Journal of Differential Equations 477 (2026), 114533",
      "description": "We study how much smoothness is needed for the Euler equations to have a unique solution that depends continuously on its starting state. By measuring smoothness more finely across different spatial scales, we establish local well-posedness and show that the solutions persist globally in two dimensions under the stated assumptions.",
      "url": "assets/papers/euler-generalized-smoothness-author.pdf",
      "source": "https://arxiv.org/abs/2510.02626",
      "publisher": "https://doi.org/10.1016/j.jde.2026.114533",
      "pdfLabel": "Author PDF"
    },
    {
      "detail": "euler-critical",
      "title": "Local Existence for the 2D Euler Equations in a Critical Sobolev Space",
      "authors": "Elaine Cozzi and Nicholas Harrison",
      "status": "Nonlinear Analysis 261 (2025), 113846",
      "description": "We prove that a two-dimensional ideal fluid retains a critical measure of vorticity smoothness for a short time, even at an endpoint where standard estimates are difficult to use. If the initial vorticity also satisfies a Dini continuity condition, that regularity persists for all time.",
      "url": "assets/papers/euler-critical-sobolev-author.pdf",
      "source": "https://arxiv.org/abs/2409.19418",
      "publisher": "https://doi.org/10.1016/j.na.2025.113846",
      "pdfLabel": "Author PDF"
    }
  ],
